# ==========================================
# Vehicle Fleet Manager - Environment Config
# ==========================================

# Port exposed in your browser for the Web UI (e.g. 8080, 5002, 80)
HOST_PORT=8080

# Port exposed for direct backend API testing (optional)
BACKEND_PORT=5000

# Host directory where persistent SQLite database is saved
DATA_DIR=./backend/data

# Host directory where automated backup snapshots are saved
BACKUP_HOST_DIR=./backups

# Automated backup schedule interval (hours)
BACKUP_INTERVAL_HOURS=24

# Automated backup retention threshold (days)
RETENTION_DAYS=30
